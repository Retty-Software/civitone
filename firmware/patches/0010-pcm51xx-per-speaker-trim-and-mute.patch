@@ -219,6 +233,13 @@
   
   ESP_LOGD(TAG, "Volume set to %d%% (register: 0x%02x)", vol, register_value);
   return ret;
+}
+
+// Civitone: rewrite both channels at the current volume, after a speaker's
+// trim or mute changed.
+esp_err_t pcm51xx_reapply_volume(void) {
+  if (i2c_handler == NULL) return ESP_ERR_INVALID_STATE;  // not up yet; the first volume write applies them
+  return pcm51xx_set_volume(pcm51xx_state.volume_percent);
 }
 
