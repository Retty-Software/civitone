diff --color -ru a/main/connection_handler.c b/main/connection_handler.c
--- a/main/connection_handler.c	2026-10-12 22:18:36
+++ b/main/connection_handler.c	2026-10-12 22:18:36
@@ -160,10 +160,18 @@
         continue;
       }
 
+      // Civitone: adoption hands nodes a hostname (the hosted server), so
+      // resolve names, not just numeric addresses. Back off on failure
+      // instead of spinning.
       if (ipaddr_aton(static_host, &remote_ip) == 0) {
-        ESP_LOGE(TAG, "can't convert static server address to numeric: %s",
