+
+  // Civitone: log jumps in the server clock offset estimate. Used to find
+  // out whether hard resyncs are caused by the estimate moving.
+  {
+    static int64_t lastLogged = 0;
+    int64_t step = medianValue - lastLogged;
+    if (lastLogged != 0 && (step > 2000 || step < -2000)) {
+      ESP_LOGW(TAG, "CIVI clock offset moved %lldus (sample %lldus from median)",
+               step, newValue - medianValue);
+    }
+    lastLogged = medianValue;
+  }
+
